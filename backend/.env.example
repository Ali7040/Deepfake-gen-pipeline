# Copy to `.env` and adjust. All values are optional (sane dev defaults exist).

# --- Security ---
SECRET_KEY=change-me-to-a-long-random-string
# JWT lifetimes
# ACCESS_TOKEN_TTL_MIN=60
# REFRESH_TOKEN_TTL_DAYS=7

# --- App ---
DEBUG=true

# --- CORS (frontend dev servers). CORS_ALLOW_ALL=true wildcards origins in dev. ---
CORS_ALLOW_ALL=true
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Storage ---
# DATABASE_URL=sqlite:///./deeptrace.db
# MAX_UPLOAD_BYTES=104857600

# --- Detection models (Hugging Face IDs; downloaded on first request) ---
# IMAGE_MODEL=prithivMLmods/Deep-Fake-Detector-Model
# VIDEO_MODEL=dima806/deepfake_vs_real_image_detection
# FACE_MIN_PROB=0.90
# FAKE_THRESHOLD=0.50
# VIDEO_FRAMES=10
# VIDEO_FAKE_RATIO=0.30

# --- Detection performance tuning ---
# Downscale longest side to this before MTCNN (0 = off). Big CPU win on large images.
# DETECT_MAX_SIDE=1024
# Pin torch CPU threads (0 = torch default).
# TORCH_NUM_THREADS=0
# Warm up models on startup so the first request isn't cold (slower boot).
# WARMUP_ON_STARTUP=false

# --- Generation proxy: URL of the existing DeepTrace face-swap FastAPI ---
GEN_BASE_URL=http://127.0.0.1:8000
# GEN_TIMEOUT=600
# Auto-spawn the gen engine when the backend boots (single-process launch).
# ON by default in this consolidated repo, so running the backend brings up the
# engine too. Run the backend WITHOUT --reload when this is on. Set false if you
# prefer to run the engine separately.
# AUTO_START_GEN_ENGINE=true
# GEN_ENGINE_DIR=

# --- Forensic report (Qwen via Hugging Face Inference API) ---
# HF_TOKEN=hf_xxx
